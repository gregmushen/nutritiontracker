# Deployment target for this checkout.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#
# deploy/deploy.env is gitignored, so host names, users and key paths stay out
# of the repository. Replace every placeholder below with your own values.

# ---------------------------------------------------------------------------
# Connection. Required by every bin/ script.
# ---------------------------------------------------------------------------
NT_DEPLOY_HOST=nutrition.local
NT_DEPLOY_USER=pi

# Path to the SSH key. Leave empty to use the agent, or whatever ~/.ssh/config
# already resolves for this host.
NT_DEPLOY_SSH_KEY=

# ---------------------------------------------------------------------------
# Public endpoint. NT_PUBLIC_HOST is the proxy host in config/deploy.yml;
# NT_PUBLIC_URL is used by the smoke tests in docs/live-smoke-test.md.
# ---------------------------------------------------------------------------
NT_PUBLIC_HOST=nutrition.example.com
NT_PUBLIC_URL=https://nutrition.example.com

# ---------------------------------------------------------------------------
# Container hosts deployed with Kamal (config/deploy.yml).
# Ignore these on a host that runs the app under systemd.
# NT_REGISTRY_HOST defaults to NT_DEPLOY_HOST when unset.
# ---------------------------------------------------------------------------
#NT_REGISTRY_HOST=registry.local
NT_DEPLOY_ARCH=arm64

# ---------------------------------------------------------------------------
# Hosts that run the app under systemd from a git checkout, driven by
# bin/install-systemd, bin/deploy, bin/db-backup and bin/db-push.
# Ignore these on a Kamal host.
# ---------------------------------------------------------------------------
NT_DEPLOY_BRANCH=master
NT_DEPLOY_DIR=/home/pi/nutritiontracker
NT_DEPLOY_SERVICE=nutritiontracker
NT_DEPLOY_DB=/home/pi/nutritiontracker/data/nutrition.db
NT_DEPLOY_BACKUP_DIR=/home/pi/db-backups

# Optional, shown with their defaults. bin/install-systemd uses these to
# render deploy/systemd/nutritiontracker.service.template.
#
# Bind to 127.0.0.1 and put a tunnel or reverse proxy in front of it. Only
# widen this to 0.0.0.0 if you understand the exposure.
#NT_BIND_HOST=127.0.0.1
#NT_APP_PORT=8000
#NT_DEPLOY_GROUP=<defaults to NT_DEPLOY_USER>
#NT_DEPLOY_ENV_FILE=/etc/nutritiontracker/nutritiontracker.env
#NT_REPO_URL=https://github.com/gregmushen/nutritiontracker.git
#NT_MULTI_USER_ENABLED=true

# Resource guards written into the unit. Sized for a 2-4 GB single-board
# computer; raise them if you serve a much larger catalog.
#NT_MEMORY_HIGH=512M
#NT_MEMORY_MAX=768M
#NT_TASKS_MAX=64
#NT_CPU_WEIGHT=100

# ---------------------------------------------------------------------------
# Where the bulk USDA and OpenFoodFacts downloads live on the host, used by
# bin/import-usda and bin/import-off.
# ---------------------------------------------------------------------------
NT_DATA_DIR=/home/pi/nutrition-data
